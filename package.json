{
  "name": "liuliangka",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:netlify": "npm run sync:products -- --force && HAOKA172_DISABLE_LIVE_FETCH=1 npm run build",
    "lint": "next lint",
    "check:products": "node scripts/check-haoka172-secret.mjs",
    "import:netlify-config": "node scripts/import-netlify-haoka172-config.mjs",
    "sync:products": "node scripts/sync-haoka172-products.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "report:funnel": "node scripts/report-funnel.mjs",
    "audit:sources": "tsx scripts/audit-haoka172-source.ts",
    "check:publish": "node scripts/check-netlify-publish.mjs",
    "deploy:netlify": "NETLIFY_SITE_ID=d35be32b-9bbb-4cc8-a0a8-b0d3056d6cca npm exec --yes --package=netlify-cli@27.10.2 -- netlify build --context production && npm run check:publish && npm exec --yes --package=netlify-cli@27.10.2 -- netlify deploy --prod --no-build --dir .netlify/static --site d35be32b-9bbb-4cc8-a0a8-b0d3056d6cca"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^15.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.15.11",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.0.4",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
